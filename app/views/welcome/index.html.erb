<h1>Harvest Tracker<h1>
  
<div class="row">
  <div class="col">
    <%= form_with(model: @user, url: admin_merchants_path , method: :post, local: true) do |f| %>
    <div>
      <%= f.label :name, 'Merchant Name' %>
      <%= f.text_field :name %>
    </div>
    <div>
      <%= f.submit 'Add Merchant' %>
    </div>
    <% end %>
  </div>
</div>